# Copie para `.env.local` e preencha. Os mesmos nomes precisam existir nas
# variáveis de ambiente da Vercel, ou as funções de `api/` respondem 500 com o
# nome da que faltou.

# Spotify: app criado no developer dashboard, com
# `http://127.0.0.1:8888/callback` na lista de Redirect URIs.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# preenchido por `node scripts/spotify-token.mjs`, que pede a autorização uma vez
SPOTIFY_REFRESH_TOKEN=

# Steam: chave da Web API e o SteamID64. O perfil precisa estar público, senão a
# API responde 200 sem o jogo atual e sem os recentes.
STEAM_API_KEY=
STEAM_ID=

# Letterboxd: só o nome de usuário. Não há chave porque não há API: o que existe
# é o RSS do perfil.
LETTERBOXD_USER=
# Opcional: a lista que vira o bloco de favoritos, como endereço inteiro ou só o
# miolo (`fulano/list/favoritos`). Vazia, a seção mostra só os vistos por último
# — lista nenhuma tem RSS, então esta sai do HTML da página dela.
LETTERBOXD_LIST=
