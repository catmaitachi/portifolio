# ─────────────────────────────────────────────────────────────
#  PORTFÓLIO — variáveis de ambiente
#  Copie para `.env` (ou `.env.local`) e ajuste os valores.
#  Tudo que começa com VITE_ é embutido no bundle do cliente:
#  NUNCA coloque segredos reais aqui (tokens de banco, chaves privadas).
# ─────────────────────────────────────────────────────────────

# ── Identidade ───────────────────────────────────────────────
VITE_OWNER_NAME="Lucas Spiazzi"
VITE_OWNER_HANDLE="lucasspiazzi"
VITE_OWNER_ROLE="Designer & desenvolvedor de produtos digitais"
VITE_OWNER_LOCATION="Brasil · remoto"
VITE_OWNER_STATUS="disponível para projetos"
# Foto do cartão neofetch do comando `sobre`.
# Coloque o arquivo em public/ e aponte aqui (ex.: /eu.jpg)
VITE_OWNER_AVATAR="/avatar.svg"
VITE_OWNER_BIO="Trabalho na interseção entre interface, movimento e sistemas — transformando problemas complexos em experiências claras e minimalistas."

# ── Aparência ────────────────────────────────────────────────
VITE_ACCENT_COLOR="#7dd3a8"
VITE_ACCENT_OPTIONS="#7dd3a8,#8ab4f8,#e0b25a,#c98af0"
VITE_SCANLINES=true
# Aparência inicial: dark | light (o visitante pode trocar no botão flutuante)
VITE_THEME_MODE="dark"
VITE_APP_VERSION="v1.0"
VITE_DEFAULT_PROMPT="visitante"

# ── Boas-vindas ──────────────────────────────────────────────
# Nomes sorteados em "Por que devo colocar meu nome?".
# Vazio = usa a lista de src/content/seed/nicknames.seed.ts
VITE_RANDOM_NICKNAMES=""

# ── Idioma ───────────────────────────────────────────────────
# Idiomas oferecidos no painel de opções (existentes: pt-BR, en)
VITE_LOCALES="pt-BR,en"
VITE_DEFAULT_LOCALE="pt-BR"
# true = tenta adivinhar pelo navegador antes de cair no padrão
VITE_DETECT_LOCALE=true

# ── Terminal ─────────────────────────────────────────────────
# Comandos exibidos como chips de sugestão (na ordem)
VITE_SUGGESTED_COMMANDS="sobre,projetos,skills,contato,ajuda"
# Comandos desabilitados sem precisar apagar o módulo
VITE_DISABLED_COMMANDS=""

# ── Fonte de conteúdo ────────────────────────────────────────
# static = arquivos de seed em src/content/seed (padrão)
# http   = API/database remoto (VITE_CONTENT_API_URL obrigatório)
VITE_CONTENT_SOURCE="static"
VITE_CONTENT_API_URL=""
VITE_CONTENT_API_TIMEOUT_MS=8000

# ── Registro de sessão ("quem está acessando") ───────────────
# vazio = grava só no localStorage do visitante
VITE_SESSION_LOG_ENDPOINT=""
VITE_SESSION_LOG_ENABLED=true

# ── Contato (sobrescreve o seed) ─────────────────────────────
VITE_CONTACT_EMAIL="ola@portfolio.dev"
VITE_CONTACT_GITHUB="https://github.com/usuario"
VITE_CONTACT_LINKEDIN="https://linkedin.com/in/usuario"
VITE_CONTACT_WEBSITE=""
