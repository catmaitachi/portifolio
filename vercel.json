{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/preview.ts": { "maxDuration": 30, "includeFiles": "src/content/shared.json" }
  },
  "redirects": [
    { "source": "/kittens", "destination": "/kittens/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/kittens/", "destination": "https://catmaitachi.github.io/kittens/" },
    { "source": "/kittens/:path*", "destination": "https://catmaitachi.github.io/kittens/:path*" }
  ]
}
